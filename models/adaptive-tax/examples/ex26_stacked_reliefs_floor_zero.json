{
  "id": "ex26",
  "scenario": "Stacked QP + solar + rent + personal relief floor taxable at zero",
  "key_assertion": "Order QP → solar → rent → PR. Later allowed amounts shrink to remaining income, not only statutory caps. Dual-YA PR is year-specific (1.2M / 1.8M) even when taxable is already 0.",
  "variants": [
    {
      "id": "ex26_ya24",
      "inputs": {
        "assessment_year": "2024_25",
        "resident_status": "resident",
        "employment_income": "500000",
        "business_income": "0",
        "investment_income": "0",
        "qualifying_payments": "0",
        "donations": "0",
        "other_reliefs": {},
        "param_set": "current",
        "filing_lines": [
          {"component_id": "qp_approved_charitable", "amount": "75000"},
          {"component_id": "inv_rents", "amount": "200000"},
          {"component_id": "relief_solar_panel", "amount": "600000"},
          {"component_id": "relief_rent", "amount": "50000"}
        ]
      },
      "expected_final_tax_lkr": "0",
      "expected_taxable_after_relief": "0",
      "expected_personal_relief": "1200000",
      "expected_sum_assessable": "700000",
