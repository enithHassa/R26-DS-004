      "expected_rule_source_ids": [
        "bootstrap:qp_approved_charitable",
        "bootstrap:solar_panel_relief",
        "bootstrap:rent_relief",
        "bootstrap:personal_relief_2024_25"
      ],
      "expected_deduction_allowed": {
        "deduct_qualifying_payment": "75000",
        "deduct_solar_panel_relief": "600000",
        "deduct_rent_relief": "25000"
      },
      "expected_rent_statutory_allowed": "50000",
