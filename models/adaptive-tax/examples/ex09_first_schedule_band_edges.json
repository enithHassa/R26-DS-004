{
  "id": "ex09",
  "scenario": "First Schedule band edge boundaries (Act-verified dual YA)",
  "key_assertion": "Taxable income at band ceilings / first rupee into next band uses correct YA rates; slab steps carry First Schedule rule_source_id.",
  "assert_variants_differ": true,
  "variants": [
    {
      "id": "ex09_ya24_top_of_band1",
      "label": "YA 2024/25 taxable exactly 500000 \u2192 only 6% band",
      "inputs": {
        "assessment_year": "2024_25",
        "resident_status": "resident",
        "employment_income": "1700000",
        "business_income": "0",
        "investment_income": "0",
        "qualifying_payments": "0",
        "donations": "0",
        "other_reliefs": {},
        "param_set": "current"
      },
      "expected_final_tax_lkr": "30000",
      "expected_rules_applied": [
        "sum_assessable",
        "apply_personal_relief",
        "slab_band_1",
        "final_tax"
      ],
      "expected_rule_source_ids": [
        "ird-ira-2017-base",
        "personal_relief",
        "fs_2024_25_band_1",
        "bootstrap:first_schedule_rates_2024_25",
        "bootstrap:first_schedule_rates",
        "bootstrap:sum_assessable",
        "bootstrap:employment_income",
        "bootstrap:personal_relief_2024_25",
        "bootstrap:personal_relief"
      ],
      "expected_taxable_after_relief": "500000"
    },
