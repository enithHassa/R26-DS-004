# Leave unset during Vite dev so the browser uses same-origin ``/api/...`` and Vite proxies:
#   ``/api/v1/optimization/*`` → http://127.0.0.1:8002 (comp-tax-optimization, path rewritten)
#   ``/api/v1/optimization-explainable-engine/*`` → http://127.0.0.1:8009
#   ``/api/v1/optimization-explainable/*`` → http://127.0.0.1:8008
#   ``/api/v1/adaptive-tax/*`` → http://127.0.0.1:8005 (Catalog Admin; no gateway required)
#   other ``/api/*`` → gateway (default http://127.0.0.1:8000)
# If you set a full URL here, the browser talks to that host directly (no Vite proxy).
# VITE_API_BASE_URL=http://localhost:8000
#
# Optional: override Component B URL for the dev proxy only
# VITE_DEV_OPTIMIZATION_URL=http://127.0.0.1:8002
# Optional: override Optimization and Explainable URL for the dev proxy only
# VITE_DEV_OPTIMIZATION_EXPLAINABLE_URL=http://127.0.0.1:8008
# Optional: override Optimization and Explainable Engine URL for the dev proxy only
# VITE_DEV_OPTIMIZATION_EXPLAINABLE_ENGINE_URL=http://127.0.0.1:8009
# Must match repo-root ``OE_ENGINE_ACT_ADMIN_TOKEN`` (Act admin API header; no UI prompt).
# VITE_OE_ENGINE_ACT_ADMIN_TOKEN=local-oe-act-admin
# Optional: override Adaptive Tax URL for the dev proxy only
# VITE_DEV_ADAPTIVE_TAX_URL=http://127.0.0.1:8005
# Optional: override Transaction Semantic URL for the dev proxy only
# VITE_DEV_TRANSACTION_SEMANTIC_URL=http://127.0.0.1:8001
# Leave unset — do NOT set a full URL unless CORS_ORIGINS includes your UI origin:
# VITE_TRANSACTION_SEMANTIC_API_BASE_URL=http://127.0.0.1:8001/v1
