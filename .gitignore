*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
.Python
develop-eggs/
downloads/
sdist/
parts/
var/
lib64/
share/python-wheels/
