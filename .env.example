# ===========================================================
# AI Tax Advisory System — environment variables
# Copy to .env and fill in secrets. Never commit .env.
#
# Sections:
#   [SHARED]  — owned by all 4 components (infra, gateway, CORS).
#   [COMP_*]  — owned by a single component. Prefix every key with the
#               component's COMP_<NAME>_ so teammates don't collide.
# ===========================================================

# ----------------------------------------------------------
# [SHARED] Database
# ----------------------------------------------------------
# "azure" (default) uses the shared Azure Postgres server.
# "local" uses the docker-compose Postgres from docker/docker-compose.yml.
DATABASE_MODE=azure

# Azure Database for PostgreSQL - Flexible Server (Central India)
DATABASE_HOST=tax-advisory-db-tax.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=tax_advisory
DATABASE_USER=taxadvisor_admin
DATABASE_PASSWORD=<ask-team-lead-for-password>
DATABASE_SSLMODE=require

# Local Postgres (used when DATABASE_MODE=local)
LOCAL_DATABASE_HOST=localhost
LOCAL_DATABASE_PORT=5432
LOCAL_DATABASE_NAME=tax_advisory
LOCAL_DATABASE_USER=tax_advisory
LOCAL_DATABASE_PASSWORD=tax_advisory

# ----------------------------------------------------------
# [SHARED] Application
# ----------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# JSON logs for audit sinks / aggregators (Azure Monitor, Datadog, ELK).
LOG_JSON=false

# ----------------------------------------------------------
# [SHARED] Gateway + component service discovery
# ----------------------------------------------------------
GATEWAY_PORT=8000
COMP_TRANSACTION_URL=http://localhost:8001      # Component 1
COMP_OPTIMIZATION_URL=http://localhost:8002     # Component 2
COMP_RECOMMENDATION_URL=http://localhost:8003   # Component 3
COMP_LLM_URL=http://localhost:8004              # Component 4
COMP_ADAPTIVE_TAX_URL=http://localhost:8005     # Component 5
COMP_OPTIMIZATION_EXPLAINABLE_URL=http://localhost:8008
COMP_OPTIMIZATION_EXPLAINABLE_ENGINE_URL=http://localhost:8009
# Phase 2 ingest embeddings (text-embedding-3-small). Same OPENAI_API_KEY.
# OE_ENGINE_EMBEDDING_MODEL=text-embedding-3-small
# Phase 3 extract (gpt-4o). Soft $15 / hard $40 caps apply to Phase 6 seed only.
# OE_ENGINE_EXTRACT_MODEL=gpt-4o
# Protected act-admin upload/review/activate (Load new act workflow).
# Must match frontend ``VITE_OE_ENGINE_ACT_ADMIN_TOKEN`` (default local-oe-act-admin).
# Act admin UI is gated by global auditor /login — no separate token form.
# OE_ENGINE_ACT_ADMIN_TOKEN=local-oe-act-admin
# Phase 6 live narrative (gpt-4o-mini). Same OPENAI_API_KEY as Adaptive Tax.
COMP_OPTIMIZATION_EXPLAINABLE_EXPLAIN_MODE=openai
COMP_OPTIMIZATION_EXPLAINABLE_OPENAI_EXPLAIN_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# [SHARED] CORS (comma-separated) and observability
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# MLFLOW_TRACKING_URI=file:./mlruns

# ----------------------------------------------------------
# [COMP_RECOMMENDATION] Component 3 — Personalized Recommendation
# Consumed by backend/comp-personalized-recommendation/app/config.py
# ----------------------------------------------------------
COMP_RECOMMENDATION_PORT=8003
# COMP_RECOMMENDATION_RULES_PATH=models/personalized-recommendation/rules/sl_tax_2024_25.yaml
# COMP_RECOMMENDATION_ARTIFACTS_DIR=models/personalized-recommendation/artifacts
# COMP_RECOMMENDATION_DATA_DIR=data/synthetic
# COMP_RECOMMENDATION_DEFAULT_TOP_K=5
# COMP_RECOMMENDATION_DEFAULT_MC_PATHS=2000
# COMP_RECOMMENDATION_DEFAULT_HORIZON_YEARS=10
# COMP_RECOMMENDATION_W_SAVINGS=0.40
# COMP_RECOMMENDATION_W_ADOPTION=0.30
# COMP_RECOMMENDATION_W_FEASIBILITY=0.20
# COMP_RECOMMENDATION_W_RISK_PENALTY=0.10

# ----------------------------------------------------------
# [COMP_OPTIMIZATION] Component 2 — Tax Strategy Optimization (it22064486)
# Consumed by backend/comp-tax-optimization/tax_opt_b_app/config.py
# ----------------------------------------------------------
COMP_OPTIMIZATION_PORT=8002
# COMP_OPTIMIZATION_RULES_PATH=models/tax-optimization/rules/it22064486_sl_tax_mvp.yaml
# COMP_OPTIMIZATION_RULES_VERSION=it22064486_mvp_2024_25

# ----------------------------------------------------------
# [COMP_LLM] Component 4 — Language model / retrieval (comp-language-model)
# Consumed by backend/comp-language-model/app/config.py
# ----------------------------------------------------------
# Path to Phase 1b corpus_v1.jsonl for TF-IDF baseline (optional; omit for stub NLU).
# COMP_LLM_CORPUS_JSONL=data/processed/ird/corpus_v1.jsonl
# COMP_LLM_RETRIEVAL_TOP_K=8
# Phase 2 Step 4: optional benchmark JSONL to fit TF-IDF centroid intent in /api/v1/nlu/parse
# COMP_LLM_INTENT_BENCHMARK_JSONL=evaluation/benchmark_seed_template.jsonl
# Optional plain-language answers on Law query (Gemini).
# COMP_LLM_ANSWER_SYNTHESIS_ENABLED=true
# COMP_LLM_GEMINI_API_KEY=<your-gemini-api-key>
# Synthesis (balanced intelligence/cost). Never a "pro" model for routine tasks.
# COMP_LLM_GEMINI_MODEL=gemini-2.5-flash
# Cheap short tasks (follow-up-question suggestions).
# COMP_LLM_GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite
# Taxpayer-specific chat grounding: answer about the caller's OWN taxpayer record
# (from the shared DB) combined with IRD citations + knowledge graph. Requires the
# chat request to carry profile_id (caller's financial_profiles.id).
# COMP_LLM_TAXPAYER_DATA_ENABLED=true
# COMP_LLM_TAXPAYER_MONTHLY_LOOKBACK=12
# The taxpayer path can also pull classified transactions (C1), personalized
# recommendations + rationale (C2/C3), behavioural answers, financial history,
# filed return detail, and active adaptive-tax rule amendments. Intent routing
# loads only the sources a given question needs; set to false to always load all.
# COMP_LLM_TAXPAYER_CONTEXT_INTENT_ROUTING=true
# COMP_LLM_TAXPAYER_MAX_TRANSACTIONS=15
# COMP_LLM_TAXPAYER_MAX_RECOMMENDATIONS=8
# COMP_LLM_TAXPAYER_HISTORY_LOOKBACK=6
# Block obvious non-tax questions and weak retrieval matches.
# COMP_LLM_DOMAIN_GATE_ENABLED=true
# COMP_LLM_DOMAIN_REQUIRE_TAX_HINTS=true
# COMP_LLM_MIN_RETRIEVAL_SCORE=0.04
# COMP_LLM_DOMAIN_MIN_QUESTION_OVERLAP=0.15
# Phase 5 — Lex Specialis rerank, Think Twice, Proof Map
# COMP_LLM_LEX_SPECIALIS_RERANK=true
# COMP_LLM_THINK_TWICE_ENABLED=true
# COMP_LLM_PROOF_MAP_ENABLED=true
# Phase 4 — Neo4j graph enrichment
# COMP_LLM_GRAPH_ENABLED=false
# NEO4J_URI=neo4j://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ----------------------------------------------------------
# [COMP_TRANSACTION]   Component 1 — add your keys with COMP_TRANSACTION_ prefix
# ----------------------------------------------------------

# ----------------------------------------------------------
# [COMP_ADAPTIVE_TAX] Component 5 — Adaptive Tax
# Consumed by backend/comp-adaptive-tax/adaptive_tax_app/config.py
# ----------------------------------------------------------
COMP_ADAPTIVE_TAX_PORT=8005
# Amendment PDF upload root (default: ~/.ai-tax-advisory/uploads/comp-adaptive-tax)
# COMP_ADAPTIVE_TAX_UPLOAD_ROOT=
# Extraction: fixture (offline/viva sample) | openai (requires OPENAI_API_KEY)
COMP_ADAPTIVE_TAX_EXTRACTION_MODE=fixture
COMP_ADAPTIVE_TAX_OPENAI_MODEL=gpt-4o-mini
# Amendment job store: postgres (default) | file (JSON on disk, no PostgreSQL — temp demo)
# COMP_ADAPTIVE_TAX_AMENDMENT_STORE=file
# COMP_ADAPTIVE_TAX_AMENDMENT_STORE_DIR=data/dev/amendment-jobs
# OPENAI_API_KEY=

# Phase 2 — Neo4j (prefer Neo4j Desktop; Docker profile adaptive-tax is optional)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adaptive-tax-dev

# Phase 2 — embedded Chroma (local folder; no Chroma server required)
CHROMA_PERSIST_DIR=data/processed/adaptive-tax/chroma
CHROMA_COLLECTION=ird_legal_evidence_v1
# Retrieval similarity noise floor only (NOT legal confidence). Experimental default.
# Choose production value from P@K/R@K eval at 0.45 / 0.50 / 0.55 / 0.60 (coverage report).
RAG_MIN_SCORE=0.55

# Phase 2 — adaptive-tax corpus (separate from Comp 4 data/processed/ird/)
COMP_ADAPTIVE_TAX_CORPUS_JSONL=data/processed/adaptive-tax/corpus_v1.jsonl

# Phase 3 — rule engine ontology / param JSON + KG backend
# Ontology dir: rate_bands_*.json, relief_caps*.json, concepts_mvp.json, mvp_calc_edges_seed.jsonl
COMP_ADAPTIVE_TAX_ONTOLOGY_DIR=models/adaptive-tax/ontology
# auto = get_kg_client() default / tests / explain (Neo4j if NEO4J_PASSWORD set, else file).
# HTTP POST /calculate always forces neo4j (503 if Desktop is down; no file fallback).
COMP_ADAPTIVE_TAX_KG_MODE=auto

# Phase 4 — RAG-grounded explanation + report + viva param override
# Explain: fixture (offline/viva template) | openai (requires OPENAI_API_KEY)
COMP_ADAPTIVE_TAX_EXPLAIN_MODE=fixture
COMP_ADAPTIVE_TAX_OPENAI_EXPLAIN_MODEL=gpt-4o-mini
# Persisted CalculateTaxResponse JSON keyed by calc_id (UUID)
COMP_ADAPTIVE_TAX_CALC_STORE_DIR=data/processed/adaptive-tax/calculations
# Runtime relief-cap override written on Sec 52 approve (demo T1≠T2)
COMP_ADAPTIVE_TAX_PARAM_OVERRIDE_PATH=data/processed/adaptive-tax/active_relief_caps.json

# Phase 5.0 — provenance contract (strict enforcement in Phase 5.0b)
COMP_ADAPTIVE_TAX_PROVENANCE_MODE=legacy
COMP_ADAPTIVE_TAX_HARVEST_DIR=models/adaptive-tax/harvest

# Catalog-admin (Add New Act). Empty token → 503 on /catalog-admin/*. Not a user password.
# COMP_ADAPTIVE_TAX_CATALOG_ADMIN_TOKEN=
# Optional isolate dir for catalog-admin jobs + hash index (leave empty in normal use).
# COMP_ADAPTIVE_TAX_CATALOG_ADMIN_WORK_DIR=

# ----------------------------------------------------------
# Optional: SQLite file DB for isolated local dev (no Azure credentials needed).
# DATABASE_MODE=sqlite
# SQLITE_PATH=data/dev.db
# ----------------------------------------------------------
